{"weeks": [{"n": 1, "shop": "波波小廚房", "cover": "cover", "sub": "一畫成語・第 1–5 個", "reward": {"id": "sailor", "img": "reward", "name": "小水手裝", "desc": "紅、藍、紫三色水手服"}, "idioms": [{"id": "i1", "no": 1, "page": 4, "day": "星期一", "idiom": "一日千里", "dish": "火箭炒飯", "dishEmoji": "rocket", "img": "s1", "parts": [["一日", "一天"], ["千里", "一千里路"]], "literal": "一天就走了一千里路，快得像火箭一樣。", "meaning": "形容進步或發展得非常快。", "tone": "good", "key": [3, "里", "「千里」的「里」是路程的「里」，不是「裏面」的「裏」。"], "scene": [["narr", "暑假前，Neko 連浮都唔識。"], ["susu", "Neko，你而家游到二十五米喇，好犀利呀！"], ["neko", "多謝你！我每日都有練習㗎。"], ["bobo", "你嘅游水技術，真係一日千里！"]], "examples": ["哥哥每天練習彈琴，琴技一日千里。", "香港的科技發展一日千里。"], "quiz": [{"q": "「一日千里」是形容甚麼？", "opts": ["進步得很快", "走路很慢", "一天睡了很久"], "a": 0}, {"q": "哪一個字是正確的？一日千＿", "opts": ["裏", "里", "理"], "a": 1}]}, {"id": "i2", "no": 2, "page": 4, "day": "星期二", "idiom": "一言為定", "dish": "勾手指菠蘿包", "img": "s2", "parts": [["一言", "一句說話"], ["為定", "就這樣決定"]], "literal": "說了一句話，就這樣決定了。", "meaning": "說好了就不再改變，表示守信用。", "tone": "good", "key": [3, "定", "是「決定」的「定」，不是「訂購」的「訂」。"], "scene": [["susu", "波波，星期六我哋一齊去公園野餐，好唔好？"], ["bobo", "好呀！我負責整三文治。"], ["neko", "我帶生果同埋水。"], ["susu", "咁就一言為定！勾手指尾！"], ["narr", "到咗星期六，三個人都準時到，冇人遲到。"]], "examples": ["我和表妹約好明天早上九時在港鐵站等，一言為定。"], "quiz": [{"q": "我們說好了星期日一起溫習，＿＿＿＿！", "opts": ["一日千里", "一言為定", "一毛不拔"], "a": 1}, {"q": "說了「一言為定」之後，應該怎樣做？", "opts": ["改變主意不去", "準時做到答應的事", "忘記了也沒關係"], "a": 1}]}, {"id": "i3", "no": 3, "page": 4, "day": "星期三", "idiom": "一落千丈", "dish": "跌落地雪糕", "img": "s3", "parts": [["一落", "一下子跌下去"], ["千丈", "一千丈那麼深"]], "literal": "一下子跌落一千丈深，跌得又快又深。（「丈」是長度單位）", "meaning": "形容成績、地位或生意等突然大大下降。", "tone": "bad", "key": [3, "丈", "是長度單位「丈」，不是「拐杖」的「杖」。"], "opposite": "一日千里", "scene": [["narr", "有一排，Susu 日日打機，冇溫習。"], ["susu", "嘩，今次默書得四十分……上次我有九十五分㗎！"], ["neko", "你嘅成績一落千丈喇。唔緊要，我陪你一齊溫習。"], ["susu", "多謝你，Neko！我以後先溫習，再玩遊戲。"]], "examples": ["他沉迷打機，成績一落千丈。", "那間餐廳的食物變差了，生意一落千丈。"], "quiz": [{"q": "「一落千丈」和哪個成語意思相反？", "opts": ["一日千里", "一言為定", "一帆風順"], "a": 0}, {"q": "哪一句用得正確？", "opts": ["我坐升降機一落千丈到地下。", "那間店鋪生意一落千丈，客人越來越少。"], "a": 1}]}, {"id": "i4", "no": 4, "page": 5, "day": "星期四", "idiom": "一帆風順", "dish": "帆船三文治", "img": "s4", "parts": [["一帆", "一張船帆"], ["風順", "順着風吹"]], "literal": "船帆順着風，船就走得很順利。", "meaning": "比喻做事非常順利，沒有困難。常用來祝福別人。", "tone": "good", "key": [1, "帆", "是「帆船」的「帆」，不是「平凡」的「凡」。"], "scene": [["narr", "今日係波波小廚房開張嘅大日子。"], ["neko", "波波，呢隻帆船送俾你。"], ["susu", "祝你嘅餐廳一帆風順！"], ["bobo", "多謝你哋！請入嚟試吓我整嘅帆船三文治！"]], "examples": ["祝你考試一帆風順，取得好成績。", "爸爸媽媽這次旅程一帆風順。"], "tip": "寫生日卡、揮春、送別卡都可以用「一帆風順」祝福別人。", "quiz": [{"q": "小美下星期參加比賽，你會怎樣祝福她？", "opts": ["祝你一落千丈！", "祝你一帆風順！", "祝你一毛不拔！"], "a": 1}, {"q": "哪一個字是正確的？一＿風順", "opts": ["凡", "番", "帆"], "a": 2}]}, {"id": "i5", "no": 5, "page": 5, "day": "星期五", "idiom": "一毛不拔", "dish": "分享蛋撻", "img": "s5", "parts": [["一毛", "一根毛"], ["不拔", "不肯拔下來"]], "literal": "連一根毛也不肯拔下來，真的很小氣。", "meaning": "比喻非常吝嗇、自私，不肯付出或分享。", "tone": "bad", "key": [3, "拔", "是「拔草」的「拔」（手字旁），不是「撥」。"], "scene": [["susu", "Neko，請問可唔可以借一支紅色筆俾我呀？"], ["neko", "唔得，呢盒係新㗎！"], ["bobo", "Neko，借一支都唔肯，咁就一毛不拔喇。"], ["neko", "對唔住，Susu，你用啦。我哋一齊畫！"], ["susu", "多謝你，Neko！"]], "examples": ["他很富有，卻一毛不拔，從不幫助別人。"], "tip": "「一毛不拔」是不好的意思，不可以用來稱讚別人「節儉」。", "quiz": [{"q": "哪一個行為是「一毛不拔」？", "opts": ["同學忘了帶擦膠，我借給他。", "有一大包糖果，卻一粒也不肯分給弟弟。"], "a": 1}, {"q": "「一毛不拔」是好的意思，還是不好的意思？", "opts": ["好的意思", "不好的意思"], "a": 1}]}], "review": {"fill": [{"q": "表姐每天練習英文，口語＿＿＿＿。", "a": "一日千里"}, {"q": "我們約好下星期一起去圖書館，＿＿＿＿！", "a": "一言為定"}, {"q": "這間玩具店貨品太貴，生意＿＿＿＿。", "a": "一落千丈"}, {"q": "新年快樂！祝你新一年＿＿＿＿！", "a": "一帆風順"}, {"q": "他有很多零用錢，卻＿＿＿＿，一點也不肯捐出來。", "a": "一毛不拔"}]}}, {"n": 2, "shop": "Neko 甜品屋", "cover": "cover2", "sub": "一畫・二畫成語・第 6–10 個", "reward": {"id": "pyjama", "img": "reward2", "name": "動物睡衣裝", "desc": "Susu 白兔、波波啤啤熊、Neko 貓貓"}, "idioms": [{"id": "i6", "no": 6, "page": 5, "day": "星期一", "idiom": "一錢不值", "dish": "零蚊曲奇", "img": "s6", "parts": [["一錢", "一個銅錢"], ["不值", "都不值得"]], "literal": "連一個銅錢都不值，完全沒有價值。", "meaning": "形容東西毫無價值。", "tone": "bad", "key": [3, "值", "是「價值」的「值」（人字旁），不是「直線」的「直」。"], "tip": "不要用「一錢不值」來形容別人的作品或努力，會令人傷心。", "scene": [["bobo", "我搵到一張麵包優惠券，可以平啲買菠蘿包！"], ["susu", "等我睇吓……波波，呢張上個月已經過咗期喇。"], ["bobo", "吓！咁呢張優惠券而家一錢不值喇。"], ["neko", "唔緊要，下次記得早啲用就得喇。"]], "examples": ["這張過期的戲票已經一錢不值了。", "沒有人要的舊報紙，一錢不值。"], "quiz": [{"q": "「一錢不值」是形容東西怎樣？", "opts": ["非常昂貴", "完全沒有價值", "只值一元"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["這件新外套很貴，一錢不值。", "那張過期的優惠券已經一錢不值。"], "a": 1}]}, {"id": "i7", "no": 7, "page": 6, "day": "星期二", "idiom": "一舉兩得", "dish": "雙層漢堡", "img": "s7", "parts": [["一舉", "做一件事"], ["兩得", "得到兩樣好處"]], "literal": "只做一件事，就得到兩樣好處。", "meaning": "做一件事，同時得到兩種好處。", "tone": "good", "key": [3, "得", "是「得到」的「得」（雙人旁），不是「我的」的「的」。"], "scene": [["susu", "部𨋢好多人呀，我哋要等好耐。"], ["bobo", "不如我哋行樓梯上去啦！"], ["neko", "好主意！又可以做運動，又可以慳電。"], ["bobo", "係呀，真係一舉兩得！"]], "examples": ["哥哥踩單車上學，既環保又健康，真是一舉兩得。", "幫媽媽淋花，又可以觀察植物寫日記，一舉兩得。"], "quiz": [{"q": "哪一件事是「一舉兩得」？", "opts": ["踩單車上學，又做運動又環保。", "一邊吃飯一邊玩遊戲機。"], "a": 0}, {"q": "哪一個字是正確的？一舉兩＿", "opts": ["的", "德", "得"], "a": 2}]}, {"id": "i8", "no": 8, "page": 6, "day": "星期三", "idiom": "一知半解", "dish": "塌塌蛋糕", "img": "s8", "parts": [["一知", "只知道一點點"], ["半解", "只明白一半"]], "literal": "只知道一點點，只明白一半。", "meaning": "知道得不多，明白得不透徹。", "tone": "bad", "key": [2, "半", "是「一半」的「半」，不是「同伴」的「伴」。"], "scene": [["narr", "Susu 睇咗一半食譜，就急急腳整蛋糕。"], ["susu", "咦？點解我個蛋糕扁咗嘅？"], ["neko", "你對個食譜一知半解，漏咗放梳打粉呀。"], ["bobo", "唔緊要，我哋一齊由頭睇晒，再整多一次！"], ["susu", "多謝你哋！今次我會睇清楚先。"]], "examples": ["他對電腦只是一知半解，所以不敢亂改設定。", "做功課前要先弄明白題目，不要一知半解。"], "quiz": [{"q": "「一知半解」的人是怎樣的？", "opts": ["甚麼都知道得很清楚", "只知道一點點，不完全明白"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["她學問很好，對歷史一知半解。", "我對下棋只是一知半解，所以常常輸。"], "a": 1}]}, {"id": "i9", "no": 9, "page": 6, "day": "星期四", "idiom": "一事無成", "dish": "冇餡湯圓", "img": "s9", "parts": [["一事", "一件事"], ["無成", "沒有做成功"]], "literal": "連一件事都沒有做成功。", "meaning": "形容甚麼事情都沒有做成功。", "tone": "bad", "key": [2, "無", "是「沒有」的「無」，不是「跳舞」的「舞」。"], "tip": "做事要定下目標、堅持完成，就不會一事無成。", "scene": [["neko", "我想學畫畫、跳舞同彈琴，但係每樣都學咗一陣就停咗……"], ["bobo", "Neko，樣樣都做一半就放棄，最後會一事無成㗎。"], ["susu", "不如你揀一樣最鍾意嘅，每日練習吓？"], ["neko", "好呀！我揀跳舞，我會堅持落去！"]], "examples": ["做事三分鐘熱度，最後只會一事無成。", "他每天都偷懶，結果一事無成。"], "quiz": [{"q": "怎樣做才不會「一事無成」？", "opts": ["每樣事情都只做一會兒", "定下目標，堅持完成"], "a": 1}, {"q": "哪一個字是正確的？一事＿成", "opts": ["舞", "無", "武"], "a": 1}]}, {"id": "i10", "no": 10, "page": 7, "day": "星期五", "idiom": "七上八下", "dish": "跳跳糖", "img": "s10", "parts": [["七上", "一時向上"], ["八下", "一時向下"]], "literal": "心好像一時上、一時落，定不下來。", "meaning": "形容心情緊張，不安定。", "tone": "neutral", "key": [2, "八", "這裏的「七」「八」不是真的數目，是形容心情上上落落。"], "scene": [["narr", "今日係學校音樂會，Susu 第一次上台唱歌。"], ["susu", "我好緊張呀，個心七上八下咁……"], ["neko", "唔使驚，深呼吸三下，你練習咗好耐㗎喇。"], ["bobo", "我哋會喺台下為你打氣！加油！"], ["susu", "多謝你哋！我準備好喇！"]], "examples": ["考試派卷前，我的心七上八下。", "等待比賽結果時，大家都七上八下。"], "quiz": [{"q": "「七上八下」是形容甚麼？", "opts": ["上落樓梯", "心情緊張不安", "數字遊戲"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["等待派成績表時，我的心七上八下。", "我們七上八下地排好隊。"], "a": 0}]}], "review": {"fill": [{"q": "這張過期的優惠券已經＿＿＿＿了。", "a": "一錢不值"}, {"q": "哥哥踩單車上學，又環保又健康，真是＿＿＿＿。", "a": "一舉兩得"}, {"q": "他對下棋規則只是＿＿＿＿，所以常常輸。", "a": "一知半解"}, {"q": "做事三分鐘熱度，最後只會＿＿＿＿。", "a": "一事無成"}, {"q": "等待公佈比賽結果時，我的心＿＿＿＿。", "a": "七上八下"}]}}, {"n": 3, "shop": "Susu 茶餐廳", "cover": "cover3", "sub": "二畫成語・第 11–15 個", "reward": {"id": "tang", "img": "reward3", "name": "新年唐裝", "desc": "Susu 紅色唐裝、波波金色唐裝、Neko 紫色唐裝"}, "review": {"fill": [{"q": "小息時，同學們＿＿＿＿地討論昨天的球賽。", "a": "七嘴八舌"}, {"q": "大家＿＿＿＿地把枱櫈搬好，準備開派對。", "a": "七手八腳"}, {"q": "新年期間，花市＿＿＿＿，非常熱鬧。", "a": "人山人海"}, {"q": "對方＿＿＿＿，我們要更加團結。", "a": "人多勢眾"}, {"q": "到外國旅行，我們要＿＿＿＿，尊重當地的習慣。", "a": "入鄉隨俗"}]}, "idioms": [{"id": "i11", "no": 11, "page": 7, "day": "星期一", "idiom": "七嘴八舌", "dish": "芒果西多士", "img": "s11", "parts": [["七嘴", "好多張嘴巴"], ["八舌", "好多條舌頭"]], "literal": "好像有很多張嘴巴、很多條舌頭一齊說話。", "meaning": "形容人多口雜，大家爭着說話。", "tone": "neutral", "toneText": "中性（形容場面）", "key": [3, "舌", "「舌」上面像「千」字，下面是「口」，不要寫成「古」。"], "scene": [["narr", "Susu 茶餐廳想出新菜式，大家一齊開會。"], ["neko", "我想做芒果西多士！"], ["bobo", "我想做朱古力雞蛋仔！"], ["susu", "大家七嘴八舌，我聽唔清楚呀。請大家一個一個講，好唔好？"], ["neko", "對唔住，我哋舉手輪流講啦。"]], "examples": ["同學們七嘴八舌地討論去哪裏旅行。", "大家七嘴八舌，老師請我們舉手輪流發言。"], "tip": "想別人聽清楚你的意見，就要舉手，輪流說話。", "quiz": [{"q": "「七嘴八舌」是形容甚麼？", "opts": ["大家爭着說話", "七個人一起吃飯", "舌頭受了傷"], "a": 0}, {"q": "哪一句用得正確？", "opts": ["圖書館裏很安靜，大家七嘴八舌。", "下課時，同學們七嘴八舌地討論旅行的事。"], "a": 1}]}, {"id": "i12", "no": 12, "page": 7, "day": "星期二", "idiom": "七手八腳", "dish": "菠蘿包", "img": "s12", "parts": [["七手", "好多隻手"], ["八腳", "好多隻腳"]], "literal": "好像有很多隻手、很多隻腳一齊做事。", "meaning": "形容很多人一齊忙着做事。", "tone": "neutral", "toneText": "中性（形容動作）", "key": [3, "腳", "「腳」左邊是「月」字旁，中間是「去」，右邊是「卩」。"], "scene": [["narr", "一大早，波波焗咗好多盒菠蘿包。"], ["bobo", "嘩，咁多盒，我一個人搬唔晒呀。"], ["susu", "唔使擔心，我哋嚟幫手！"], ["narr", "大家七手八腳，一陣間就搬好晒。"], ["bobo", "多謝你哋！請你哋食熱辣辣嘅菠蘿包！"]], "examples": ["同學們七手八腳地布置課室。", "一家人七手八腳地準備晚飯。"], "quiz": [{"q": "「七手八腳」是形容甚麼？", "opts": ["有七隻手和八隻腳的怪物", "很多人一齊忙着做事", "做事很慢"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["大家七手八腳地把枱櫈搬好。", "他一個人七手八腳地睡午覺。"], "a": 0}]}, {"id": "i13", "no": 13, "page": 8, "day": "星期三", "idiom": "人山人海", "dish": "蛋撻", "img": "s13", "parts": [["人山", "人多到好似山"], ["人海", "人多到好似海"]], "literal": "人多得好像山一樣高、海一樣大。", "meaning": "形容人非常多。", "tone": "neutral", "toneText": "中性（形容場面）", "key": [3, "海", "「海」是三點水，右邊是「每」，不是「母」。"], "scene": [["narr", "星期日早上，茶餐廳門外排滿咗人。"], ["neko", "嘩，人山人海呀！"], ["susu", "原來大家都想食波波整嘅蛋撻。"], ["bobo", "請大家排隊，慢慢嚟，唔該晒！"]], "examples": ["年宵花市人山人海，十分熱鬧。", "煙花匯演時，海旁人山人海。"], "opposite": "寥寥無幾", "quiz": [{"q": "「人山人海」是形容甚麼？", "opts": ["山上有很多海水", "只有一兩個人", "人非常多"], "a": 2}, {"q": "哪一句用得正確？", "opts": ["新年期間，花市人山人海。", "下雨天，公園人山人海，一個人也沒有。"], "a": 0}]}, {"id": "i14", "no": 14, "page": 8, "day": "星期四", "idiom": "人多勢眾", "dish": "絲襪奶茶", "img": "s14", "parts": [["人多", "人數好多"], ["勢眾", "力量好大"]], "literal": "人數多，聲勢和力量就大。", "meaning": "形容人數多，力量強大。", "tone": "neutral", "toneText": "中性（形容人數）", "key": [2, "勢", "「勢」下面是「力」，不是「刀」。人多，力量就大。"], "scene": [["narr", "運動會有拔河比賽。"], ["susu", "對面隊人多勢眾，我哋會唔會輸呀？"], ["neko", "唔緊要，我哋齊心合力就得！"], ["bobo", "一、二、三，拉！"], ["narr", "比賽完咗，兩隊互相握手，講聲多謝。"]], "examples": ["對方人多勢眾，我們要想好方法。", "我們人多勢眾，很快便把公園的垃圾執乾淨。"], "tip": "就算人多勢眾，都不可以恃着人多去欺負別人。", "quiz": [{"q": "「人多勢眾」是形容甚麼？", "opts": ["人數多，力量大", "人很多但很弱小", "一個人很強壯"], "a": 0}, {"q": "哪一句用得正確？", "opts": ["我一個人人多勢眾。", "對方人多勢眾，我們要更加團結。"], "a": 1}]}, {"id": "i15", "no": 15, "page": 8, "day": "星期五", "idiom": "入鄉隨俗", "dish": "日式飯糰", "img": "s15", "parts": [["入鄉", "去到一個地方"], ["隨俗", "跟隨當地習慣"]], "literal": "去到一個地方，就跟隨那裏的風俗習慣。", "meaning": "到了新的地方，要尊重和跟隨當地的習慣。", "tone": "good", "key": [0, "入", "「入」和「人」很相似：「入」左邊一撇短，右邊一捺長，不要寫成「人」。"], "scene": [["narr", "Susu 一家去日本旅行，入去一間餐廳食飯。"], ["neko", "咦，大家都除咗鞋先入去喎。"], ["susu", "我哋入鄉隨俗，都除鞋啦。"], ["bobo", "對唔住，我差啲唔記得。我放好對鞋先。"], ["neko", "唔該晒姐姐幫我哋帶位！"]], "examples": ["到日本旅行，我們入鄉隨俗，進屋前先脫鞋。", "新同學入鄉隨俗，很快便習慣了學校的規矩。"], "quiz": [{"q": "「入鄉隨俗」是甚麼意思？", "opts": ["回到自己的家鄉", "到新地方跟隨當地習慣", "跟着別人走路"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["去泰國旅行，我們入鄉隨俗，進寺廟前先脫鞋。", "他入鄉隨俗，在圖書館大聲講電話。"], "a": 0}]}]}, {"n": 4, "shop": "波波雪糕車", "cover": "cover4", "sub": "三畫成語・第 16–20 個", "reward": {"id": "winter", "img": "reward4", "name": "冬日雪地裝", "desc": "Susu 紅色大褸、波波熊仔冷帽、Neko 貓貓耳罩"}, "review": {"fill": [{"q": "做功課要專心，不可以＿＿＿＿。", "a": "三心二意"}, {"q": "姐姐＿＿＿＿就把故事的重點說完了。", "a": "三言兩語"}, {"q": "參觀海洋公園令我＿＿＿＿。", "a": "大開眼界"}, {"q": "裁判＿＿＿＿，大家都很信任他。", "a": "大公無私"}, {"q": "西貢＿＿＿＿，是遠足的好地方。", "a": "山明水秀"}]}, "idioms": [{"id": "i16", "no": 16, "page": 9, "day": "星期一", "idiom": "三心二意", "dish": "士多啤梨雪糕", "img": "s16", "parts": [["三心", "好幾個心思"], ["二意", "兩樣主意"]], "literal": "心裏一時想這樣，一時想那樣。", "meaning": "形容拿不定主意，或者做事不專心。", "tone": "bad", "key": [3, "意", "「意」上面是「音」，下面是「心」。"], "scene": [["narr", "雪糕車嚟咗，Susu 排隊揀雪糕。"], ["susu", "我要士多啤梨……唔係，朱古力……都係芒果好啲？"], ["neko", "Susu，你三心二意，後面好多人等緊呀。"], ["susu", "對唔住！我決定咗，要士多啤梨味。"], ["bobo", "好嘅，請等等，即刻整俾你！"]], "examples": ["他做功課時三心二意，一時看電視，一時玩玩具。", "學東西不可以三心二意，要專心。"], "opposite": "一心一意", "quiz": [{"q": "「三心二意」是形容甚麼？", "opts": ["拿不定主意、做事不專心", "有三個心臟", "做事非常專心"], "a": 0}, {"q": "哪一句用得正確？", "opts": ["妹妹三心二意地吃了三碗飯。", "他一時想學琴，一時想學畫，真是三心二意。"], "a": 1}]}, {"id": "i17", "no": 17, "page": 9, "day": "星期二", "idiom": "三言兩語", "dish": "朱古力雪糕", "img": "s17", "parts": [["三言", "幾句說話"], ["兩語", "幾句說話"]], "literal": "只說了三幾句話。", "meaning": "形容說話不多，很簡短。", "tone": "neutral", "toneText": "中性（形容說話）", "key": [3, "語", "「語」是「言」字旁，右邊是「吾」。"], "scene": [["narr", "老師請波波向全班介紹雪糕車。"], ["bobo", "我哋嘅雪糕車……有好多味……又有……又有……"], ["neko", "波波，你可以三言兩語講重點呀。"], ["bobo", "好！雪糕車，又好味又開心，歡迎大家嚟！"], ["susu", "講得好好呀，多謝波波！"]], "examples": ["他三言兩語便把事情說清楚了。", "老師三言兩語就解答了我的問題。"], "quiz": [{"q": "「三言兩語」是形容甚麼？", "opts": ["說話很簡短", "說了三十句話", "會說兩種語言"], "a": 0}, {"q": "哪一句用得正確？", "opts": ["他講了一個鐘頭，真是三言兩語。", "媽媽三言兩語就把路線說清楚了。"], "a": 1}]}, {"id": "i18", "no": 18, "page": 9, "day": "星期三", "idiom": "大開眼界", "dish": "藍莓雪條", "img": "s18", "parts": [["大開", "打開得好大"], ["眼界", "看到的世界"]], "literal": "眼睛好像打開得很大，看到很多新東西。", "meaning": "看到新奇、從未見過的事物，增長了見識。", "tone": "good", "key": [3, "界", "「界」上面是「田」，下面是「介」。"], "scene": [["narr", "大家去水族館參觀。"], ["susu", "嘩，原來有咁大嘅鯨鯊！"], ["neko", "仲有會發光嘅水母，真係大開眼界！"], ["bobo", "多謝導賞姐姐講解，我學識好多嘢！"]], "examples": ["參觀科學館，令我大開眼界。", "這次旅行讓我們大開眼界。"], "quiz": [{"q": "「大開眼界」是甚麼意思？", "opts": ["眼睛張得很大", "看到新奇事物，增長見識", "打開窗看風景"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["參觀太空館令我大開眼界。", "我每天看同一本書，真是大開眼界。"], "a": 0}]}, {"id": "i19", "no": 19, "page": 10, "day": "星期四", "idiom": "大公無私", "dish": "雪糕新地", "img": "s19", "parts": [["大公", "處處公平"], ["無私", "沒有私心"]], "literal": "做事非常公平，沒有一點私心。", "meaning": "形容辦事公正，不偏幫自己或好朋友。", "tone": "good", "key": [3, "私", "「私」左邊是「禾」字旁，右邊是「厶」。"], "scene": [["narr", "Susu 做班長，派雪糕俾全班同學。"], ["bobo", "Susu，我哋係好朋友，可唔可以俾多一杯我？"], ["susu", "對唔住，每人一杯，咁先公平。"], ["neko", "Susu 大公無私，真係好班長！"], ["bobo", "你講得啱，我排隊等啦。"]], "examples": ["法官判案大公無私。", "班長大公無私，同學都很信任她。"], "tip": "就算係好朋友，都要公平對待每一個人。", "quiz": [{"q": "「大公無私」是形容甚麼？", "opts": ["只幫自己的朋友", "辦事公正，沒有私心", "很大方，常常送禮物"], "a": 1}, {"q": "哪一句用得正確？", "opts": ["裁判大公無私，兩隊都很服氣。", "他只把獎品給好朋友，真是大公無私。"], "a": 0}]}, {"id": "i20", "no": 20, "page": 10, "day": "星期五", "idiom": "山明水秀", "dish": "綠茶雪糕", "img": "s20", "parts": [["山明", "山色明亮"], ["水秀", "河水秀麗"]], "literal": "山色明亮，河水清秀。", "meaning": "形容風景優美。", "tone": "good", "key": [3, "秀", "「秀」上面是「禾」，下面是「乃」。"], "scene": [["narr", "星期日，大家坐雪糕車去